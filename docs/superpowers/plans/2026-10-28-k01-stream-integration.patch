diff --git a/frontend/src/utils/adaptiveAudioBuffer.js b/frontend/src/utils/adaptiveAudioBuffer.js
new file mode 100644
index 0000000..f28db33
--- /dev/null
+++ b/frontend/src/utils/adaptiveAudioBuffer.js
@@ -0,0 +1,18 @@
+// Experimental policy for PCM playback after a network underrun. Times are
+// AudioContext seconds. It does not buffer the first chunk or change audio data.
+export function createAdaptiveAudioBuffer() {
+  const underrunThreshold = 0.08;
+  const recoveryBuffer = 0.08;
+  const cooldown = 2.0;
+  let lastAdjustment = -Infinity;
+  return {
+    schedule(now, nextTime) {
+      const earliest = Math.max(now, nextTime);
+      if (now - nextTime >= underrunThreshold && now - lastAdjustment >= cooldown) {
+        lastAdjustment = now;
+        return earliest + recoveryBuffer;
+      }
+      return earliest;
+    },
+  };
+}
diff --git a/frontend/src/utils/chatMetrics.js b/frontend/src/utils/chatMetrics.js
new file mode 100644
index 0000000..0809407
--- /dev/null
+++ b/frontend/src/utils/chatMetrics.js
@@ -0,0 +1,48 @@
+const FIELDS = Object.freeze({
+  text_received: "text_received_ms",
+  audio_received: "audio_received_ms",
+  audio_scheduled: "audio_scheduled_ms",
+});
+const recent = [];
+const MAX_SAMPLES = 20;
+
+// Session-local diagnostics contain only relative durations and the outcome.
+// They are neither persisted nor sent over the network.
+export function createChatMetrics(now = () => globalThis.performance.now()) {
+  const started = now();
+  const sample = {};
+  return {
+    mark(name) {
+      const field = FIELDS[name];
+      if (field && sample[field] === undefined) sample[field] = Math.max(0, Math.round(now() - started));
+    },
+    recordAudioGap(gapMs, extraBufferMs) {
+      if (!Number.isFinite(gapMs) || gapMs <= 0) return;
+      sample.pcm_underrun_count = (sample.pcm_underrun_count || 0) + 1;
+      sample.pcm_gap_ms = (sample.pcm_gap_ms || 0) + Math.round(gapMs);
+      sample.pcm_extra_buffer_ms = (sample.pcm_extra_buffer_ms || 0)
+        + Math.max(0, Math.round(Number.isFinite(extraBufferMs) ? extraBufferMs : 0));
+    },
+    finish(outcome) {
+      if (sample.outcome === undefined) {
+        sample.outcome = ["complete", "incomplete", "stopped"].includes(outcome) ? outcome : "incomplete";
+        sample.duration_ms = Math.max(0, Math.round(now() - started));
+      }
+      return sample;
+    },
+  };
+}
+
+export function rememberChatMetrics(sample) {
+  recent.push(sample);
+  if (recent.length > MAX_SAMPLES) recent.shift();
+}
+
+export function getRecentChatMetrics() {
+  return recent.map((sample) => ({ ...sample }));
+}
+
+// Development-only inspection; production never exposes or uploads the samples.
+if (import.meta.env.DEV && typeof window !== "undefined") {
+  window.getGuideChatMetrics = getRecentChatMetrics;
+}
diff --git a/frontend/src/utils/latestRequest.js b/frontend/src/utils/latestRequest.js
new file mode 100644
index 0000000..e52f1af
--- /dev/null
+++ b/frontend/src/utils/latestRequest.js
@@ -0,0 +1,18 @@
+// Keep one in-flight operation per consumer and ignore late outcomes after cancellation.
+export function createLatestRequest() {
+  let controller = null;
+  let generation = 0;
+  function cancel() {
+    generation += 1;
+    controller?.abort();
+    controller = null;
+  }
+  function begin() {
+    cancel();
+    controller = new AbortController();
+    const current = controller;
+    const token = generation;
+    return { signal: current.signal, isCurrent: () => generation === token && controller === current };
+  }
+  return { begin, cancel };
+}
diff --git a/frontend/src/utils/publicationRecovery.js b/frontend/src/utils/publicationRecovery.js
new file mode 100644
index 0000000..f177baf
--- /dev/null
+++ b/frontend/src/utils/publicationRecovery.js
@@ -0,0 +1,73 @@
+const STORAGE_KEY = "guide-pending-publication-v1";
+const copy = (value) => JSON.parse(JSON.stringify(value));
+
+// Keep the exact idempotency key and selected revisions until the outcome of
+// a publication is known. Nothing here retries automatically.
+export function createPublicationRecovery({ storage, createKey, submit }) {
+  let pending;
+  let loaded = false;
+  let durable = !!storage;
+  let inFlight = null;
+
+  function load() {
+    if (loaded) return pending;
+    loaded = true;
+    try {
+      const raw = storage?.getItem(STORAGE_KEY);
+      if (!raw) return null;
+      const parsed = JSON.parse(raw);
+      if (!parsed || typeof parsed.key !== "string" || !parsed.key || !Array.isArray(parsed.items) || !parsed.items.length) {
+        throw new Error("发布记录损坏，无法安全确认原任务；请联系管理员核对。");
+      }
+      pending = parsed;
+      return pending;
+    } catch (error) {
+      if (error instanceof SyntaxError || error?.message?.includes("发布记录损坏")) {
+        loaded = false;
+        throw new Error("发布记录损坏，无法安全确认原任务；请联系管理员核对。");
+      }
+      durable = false;
+      return pending || null;
+    }
+  }
+
+  function save(value) {
+    pending = value;
+    loaded = true;
+    try {
+      if (!storage) throw new Error("storage unavailable");
+      if (value) storage.setItem(STORAGE_KEY, JSON.stringify(value));
+      else storage.removeItem(STORAGE_KEY);
+    } catch { durable = false; }
+  }
+
+  function getPending() {
+    const value = load();
+    return value ? copy(value) : null;
+  }
+
+  function begin(items) {
+    if (load()) throw new Error("已有发布任务待确认，请先恢复原任务。");
+    if (!Array.isArray(items) || !items.length) throw new Error("请选择需要发布的草稿。");
+    const value = { key: createKey(), items: copy(items), jobId: null };
+    if (!value.key) throw new Error("无法创建发布请求标识，请检查浏览器安全设置。");
+    save(value);
+    return getPending();
+  }
+
+  async function submitPending() {
+    const value = load();
+    if (!value) throw new Error("没有待确认的发布任务。");
+    if (value.jobId) throw new Error("发布任务已创建，请查询原任务状态。");
+    if (inFlight) return inFlight;
+    inFlight = (async () => {
+      const job = await submit(copy(value.items), value.key);
+      if (!job || typeof job.id !== "string" || !job.id) throw new Error("发布结果无任务标识，请恢复确认。");
+      save({ ...value, jobId: job.id });
+      return job;
+    })();
+    try { return await inFlight; } finally { inFlight = null; }
+  }
+
+  return { begin, getPending, submitPending, clear: () => save(null), isDurable: () => durable };
+}
