{
  "name": "a5-scenic-guide-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:tourist",
    "dev:tourist": "node scripts/prepare-public.mjs tourist && vite --config vite.tourist.config.js",
    "dev:admin": "node scripts/prepare-public.mjs admin && vite --config vite.admin.config.js",
    "build": "npm run build:tourist && npm run build:admin",
    "build:tourist": "node scripts/prepare-public.mjs tourist && vite build --config vite.tourist.config.js",
    "build:admin": "node scripts/prepare-public.mjs admin && vite build --config vite.admin.config.js",
    "build:legacy": "vite build --config vite.config.js",
    "test": "node --test",
    "preview": "npm run preview:legacy",
    "preview:legacy": "vite preview --config vite.config.js",
    "preview:tourist": "vite preview --config vite.tourist.config.js",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "check:app-boundaries": "node scripts/check-app-boundaries.mjs",
    "check:build-boundaries": "node scripts/check-build-boundaries.mjs",
    "check:build-isolation": "node scripts/check-build-isolation.mjs",
    "test:offline-e2e": "node tests/e2e/offline.e2e.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "axios": "^1.11.0",
    "dompurify": "^3.4.11",
    "echarts": "^6.1.0",
    "element-plus": "^2.11.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.5",
    "pinia": "^3.0.3",
    "three": "^0.184.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright-core": "^1.56.1",
    "vite": "^7.1.2"
  }
}
